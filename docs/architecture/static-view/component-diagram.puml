@startuml
title LAMBA Architecture Component Diagram

top to bottom direction
skinparam nodesep 100
skinparam ranksep 150
skinparam componentStyle uml2

actor "Car Owner" as User

package "LAMBA System" {

  package "Client Layer" {
    component "Android Mobile App\n(Kotlin / Jetpack Compose)" as AndroidApp
  }

  interface "REST/JSON API" as REST

  package "Backend Layer" {
    component "FastAPI Backend\nAPI Routes" as BackendAPI
    component "Backend Application Logic\nAuth, Cars, Records,\nAssistant Service" as Services
  }

  interface "Persistence API" as Persistence

  package "Data Layer" {
    component "CRUD / Repository Layer" as Repository
    interface "SQL Database Interface" as SQLDB
    database "PostgreSQL Database" as Postgres
    interface "Schema Migration Interface" as MigrationInterface
    component "Alembic Migrations" as Alembic

    Postgres -left- SQLDB
    SQLDB )-left- Repository

    Postgres -right- MigrationInterface
    MigrationInterface )-right- Alembic
  }
}

package "External Ecosystem" {
  interface "AI Provider API" as AIAPI
  component "OpenAI-compatible\nAI Provider" as AIProvider
  interface "Database Admin API" as DBAdmin
  component "pgAdmin" as PgAdmin
}

User --> AndroidApp : uses

BackendAPI -up- REST
REST )-up- AndroidApp

BackendAPI --> Services : delegates

Repository -up- Persistence
Persistence )-up- Services

AIProvider -left- AIAPI
AIAPI )-left- Services

Postgres -right- DBAdmin
DBAdmin )-right- PgAdmin

@enduml
